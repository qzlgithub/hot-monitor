# 热点监控系统 - 后端配置

# API 服务
PORT=3000
NODE_ENV=development

# AI 服务 (DeepSeek API)
# 从 https://platform.deepseek.com 获取
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_API_URL=https://api.deepseek.com/v1

# ============================================
# 数据源配置中心
# ============================================
# 只需把对应 ENABLED 改为 true 并填好 key/cookie，即可启用该数据源
# AI 检测门槛：相关性得分低于 AI_MIN_SCORE 的候选不进入热点（默认 7，宁缺毋滥）
AI_MIN_SCORE=7

# 百度（默认关闭；需要时改为 true 启用）
BAIDU_ENABLED=false

# Bilibili（哔哩哔哩，国内热点，默认启用，无需 key）
# 数据来自 B 站公开接口：热门列表 + 关键词搜索
# 关键词搜索按播放量过滤：低于 BILIBILI_MIN_PLAY 的视频不进热点（默认 50000，即 5 万）
BILIBILI_ENABLED=true
BILIBILI_MIN_PLAY=50000

# Google（需 API Key）
GOOGLE_ENABLED=false
GOOGLE_API_KEY=

# 知乎（需登录 Cookie）
ZHIHU_ENABLED=false
ZHIHU_COOKIE=

# Twitter/X（通过 twitterapi.io 第三方 API，无需官方开发者审核）
# 1) 到 https://twitterapi.io/dashboard 注册并获取 API Key（免费送 $0.1 额度，按量付费）
# 2) 填入下方 TWITTER_API_KEY 并把 TWITTER_ENABLED 改为 true
# 认证方式：请求头 X-API-Key（非官方 Bearer Token）
TWITTER_ENABLED=false
TWITTER_API_KEY=your_twitterapi_io_key_here
TWITTER_API_URL=https://api.twitterapi.io

# 邮件通知配置
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM=noreply@hotmonitor.local

# 数据存储路径
DATA_DIR=./src/data

# 任务调度
HOTSPOT_FETCH_INTERVAL=30
NOTIFICATION_CHECK_INTERVAL=5
